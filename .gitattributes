# Fontes e logos são binários: o git nunca deve tentar converter fim de linha neles.
*.otf binary
*.ttf binary
*.png binary

# Scripts de shell do Windows precisam de CRLF para rodar em qualquer máquina.
*.bat text eol=crlf
*.ps1 text eol=crlf

# O resto normaliza para LF no repositório.
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
